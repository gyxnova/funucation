  "lyrics": [
    { "text": "Every input has a weight,", "start": 9.0, "end": 11.4, "scene": "weights_light" },
    { "text": "Half, or minus one, or two,", "start": 11.4, "end": 13.8, "scene": "weights_light" },
    { "text": "Big ones matter more to us,", "start": 13.8, "end": 16.2, "scene": "weights_light" },
    { "text": "Negative weights push back on you.", "start": 16.2, "end": 18.6, "scene": "weights_light" },
    { "text": "Bias is a starting nudge,", "start": 18.6, "end": 21.0, "scene": "bias_node" },
    { "text": "Minus one to set the bar,", "start": 21.0, "end": 23.4, "scene": "bias_node" },
    { "text": "Added to the total sum,", "start": 23.4, "end": 25.8, "scene": "bias_node" },
    { "text": "So the weights must reach that far.", "start": 25.8, "end": 28.2, "scene": "bias_node" },

    { "text": "", "start": 28.2, "end": 30.4, "scene": "recap", "show_text": false, "caption": "multiply: w x input" },
    { "text": "", "start": 30.60, "end": 33.16, "scene": "recap", "show_text": false, "caption": "add them up, then add the bias: + b" },
    { "text": "", "start": 33.42, "end": 35.44, "scene": "recap", "show_text": false, "caption": "z = w1x1 + w2x2 + w3x3 + b" },
    { "text": "", "start": 35.68, "end": 37.94, "scene": "recap", "show_text": false, "caption": "z >= 0  ->  FIRE" },
    { "text": "", "start": 38.16, "end": 40.32, "scene": "recap", "show_text": false, "caption": "multiply: w x input" },
    { "text": "", "start": 40.56, "end": 42.64, "scene": "recap", "show_text": false, "caption": "add them up, then add the bias: + b" },
    { "text": "", "start": 42.82, "end": 44.88, "scene": "recap", "show_text": false, "caption": "z = w1x1 + w2x2 + w3x3 + b" },
    { "text": "", "start": 45.06, "end": 47.44, "scene": "recap", "show_text": false, "caption": "z >= 0  ->  FIRE" },

    { "text": "Inputs are one, then zero, then one,", "start": 48.58, "end": 50.74, "scene": "inputs_bounce" },
    { "text": "Half times one is half, the first is done,", "start": 50.84, "end": 53.12, "scene": "sum_node" },
    { "text": "Zero times minus one is zero, no more,", "start": 53.16, "end": 55.48, "scene": "sum_node" },
    { "text": "Two times one is two, now add the score:", "start": 55.50, "end": 57.90, "scene": "sum_node" },
    { "text": "Sum is two point five, bias minus one,", "start": 57.94, "end": 60.18, "scene": "sum_node" },
    { "text": "Zee is one point five, so fire's begun.", "start": 60.18, "end": 62.44, "scene": "gate_fire" },
    { "text": "Step gate fires when zee clears zero,", "start": 62.64, "end": 64.76, "scene": "gate_fire" },
    { "text": "Sigmoid bends it, soft and slow,", "start": 64.98, "end": 67.00, "scene": "sigmoid_curve" },
    { "text": "Squashing zee to between zero and one,", "start": 67.20, "end": 69.52, "scene": "sigmoid_curve" },
    { "text": "Ours reads point eight two, there you go.", "start": 69.56, "end": 72.86, "scene": "sigmoid_curve" },

    { "text": "", "start": 73.40, "end": 75.16, "scene": "recap", "show_text": false, "caption": "multiply: w x input" },
    { "text": "", "start": 75.58, "end": 77.56, "scene": "recap", "show_text": false, "caption": "add them up, then add the bias: + b" },
    { "text": "", "start": 77.76, "end": 79.86, "scene": "recap", "show_text": false, "caption": "z = w1x1 + w2x2 + w3x3 + b" },
    { "text": "", "start": 80.04, "end": 82.38, "scene": "recap", "show_text": false, "caption": "z >= 0  ->  FIRE" },
    { "text": "", "start": 82.56, "end": 84.72, "scene": "recap", "show_text": false, "caption": "multiply: w x input" },
    { "text": "", "start": 84.92, "end": 86.84, "scene": "recap", "show_text": false, "caption": "add them up, then add the bias: + b" },
    { "text": "", "start": 86.92, "end": 89.34, "scene": "recap", "show_text": false, "caption": "z = w1x1 + w2x2 + w3x3 + b" },
    { "text": "", "start": 89.62, "end": 92.13, "scene": "recap", "show_text": false, "caption": "z >= 0  ->  FIRE" },

    { "text": "If it fires when it should not,", "start": 110.0, "end": 114.84, "scene": "weight_update" },
    { "text": "Nudge the weights and bias down,", "start": 116.20, "end": 118.65, "scene": "weight_update" },
    { "text": "Only inputs that were on", "start": 119.66, "end": 124.16, "scene": "weight_update" },
    { "text": "Change, the zero ones hold their ground.", "start": 124.84, "end": 128.20, "scene": "weight_update" },

    { "text": "", "start": 129.44, "end": 131.44, "scene": "recap", "show_text": false, "caption": "multiply: w x input" },
    { "text": "", "start": 131.86, "end": 133.62, "scene": "recap", "show_text": false, "caption": "add them up, then add the bias: + b" },
    { "text": "", "start": 133.96, "end": 136.00, "scene": "recap", "show_text": false, "caption": "z = w1x1 + w2x2 + w3x3 + b" },
    { "text": "", "start": 136.24, "end": 138.52, "scene": "recap", "show_text": false, "caption": "z >= 0  ->  FIRE" },
    { "text": "", "start": 138.84, "end": 140.94, "scene": "recap", "show_text": false, "caption": "multiply: w x input" },
    { "text": "", "start": 141.02, "end": 142.90, "scene": "recap", "show_text": false, "caption": "add them up, then add the bias: + b" },
    { "text": "", "start": 142.92, "end": 145.54, "scene": "recap", "show_text": false, "caption": "z = w1x1 + w2x2 + w3x3 + b" },
    { "text": "", "start": 145.88, "end": 147.88, "scene": "recap", "show_text": false, "caption": "z >= 0  ->  FIRE" }
  ],
